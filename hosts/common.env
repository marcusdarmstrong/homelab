# Settings every host shares. A host's own file overrides any of these; see
# hosts/README.md for every setting.

# Zone for everything homelab. Hosts live at <host>.HOMELAB_DOMAIN, and the
# services that run once (Pocket ID, Grafana, ntfy, ...) at
# <service>.HOMELAB_DOMAIN, wherever they run.
HOMELAB_DOMAIN=homelab.marmstrong.cloud
TZ=America/New_York
