# luna: the Pi 4 at home. See hosts/README.md for every setting.
COMPOSE_PROFILES=dns,unifi
SITE=home
HOST_STORAGE=sdcard
# The home site's UniFi console (its gateway).
UNIFI_URL=https://192.168.1.1
# Its PoE HAT's fan: the defaults step up at 50°C, right where luna idles.
POE_FAN_TEMPS=40,45,55,60
POE_FAN_HYST=3
