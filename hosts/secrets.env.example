# Secrets for every host. Copy to hosts/secrets.env (gitignored), fill it in,
# and keep a copy in your password manager: it's the one part of the system
# that isn't in git. A secret only one host needs (UNIFI_API_KEY) goes in
# hosts/<name>.secrets.env instead. scripts/push-env.sh <name> assembles both,
# plus HOST_NAME, into that host's .env.
#
# scripts/gen-secrets.sh prints fresh values for every generated secret.
# Values containing `$` (bcrypt hashes) must be in 'single quotes'.

# ---- TLS and DNS ---------------------------------------------------------------
ACME_EMAIL=changeme@example.com
# Cloudflare API token with Zone → DNS → Edit on the zone holding
# HOMELAB_DOMAIN. Traefik uses it for certificates; the dns-records services
# keep each host's and service's records current with it.
CF_DNS_API_TOKEN=changeme

# ---- Tailscale -----------------------------------------------------------------
# OAuth client secret with ?ephemeral=false&preauthorized=true appended
# (README → External setup). Used only for a host's first login.
TS_AUTHKEY=changeme

# ---- SSO -------------------------------------------------------------------------
# Generated. Encrypts Pocket ID's signing keys; its backups are useless
# without it.
POCKET_ID_ENCRYPTION_KEY=changeme-at-least-16-chars
# From the OIDC clients you create in Pocket ID after its first start (README
# → Single sign-on). Until set, admin pages behind SSO are unreachable.
TINYAUTH_OIDC_CLIENT_ID=
TINYAUTH_OIDC_CLIENT_SECRET=
GRAFANA_OIDC_CLIENT_ID=
GRAFANA_OIDC_CLIENT_SECRET=

# ---- Backups (restic on Cloudflare R2) -------------------------------------------
# Each service with state backs up to its own bucket, named
# RESTIC_REPOSITORY_PREFIX + service (homelab-pocket-id).
RESTIC_REPOSITORY_PREFIX=s3:https://<account-id>.r2.cloudflarestorage.com/homelab-
# Generated. Without it the backups can't be decrypted.
RESTIC_PASSWORD=changeme
# An R2 API token with Object Read & Write on those buckets.
RESTIC_S3_ACCESS_KEY_ID=changeme
RESTIC_S3_SECRET_ACCESS_KEY=changeme

# ---- Alerts (ntfy) ---------------------------------------------------------------
# Generated: the token Grafana publishes alerts with (tk_ + 29 chars), and a
# bcrypt hash of a throwaway password for the `grafana` ntfy user.
NTFY_GRAFANA_TOKEN=changeme
NTFY_GRAFANA_PASSWORD_HASH='changeme'
# Generated: bcrypt hash of the password phones subscribe with, as user
# `phone`. Keep the password itself in your password manager.
NTFY_PHONE_PASSWORD_HASH='changeme'
# Optional: a healthchecks.io ping URL. The observability host pings it every
# five minutes; healthchecks.io tells you when the pings stop.
HEALTHCHECKS_URL=
