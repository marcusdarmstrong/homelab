{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
  ],
  dependencyDashboard: {
    enabled: true,
  },
  minimumReleaseAge: '14 days',
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/(^|/)Dockerfile$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\nARG \\w+=(?<currentValue>\\S+)',
      ],
      extractVersionTemplate: '^v?(?<version>.*)$',
    },
  ],
  packageRules: [
    {
      matchManagers: [
        'docker-compose',
      ],
      matchPackageNames: [
        'grafana/**',
        'prom/**',
      ],
      groupName: 'observability',
    },
    {
      matchPackageNames: [
        'ghcr.io/pocket-id/**',
        'ghcr.io/tinyauthapp/**',
      ],
      groupName: 'sso',
    },
    {
      matchUpdateTypes: [
        'patch',
      ],
      automerge: true,
    },
  ],
}
