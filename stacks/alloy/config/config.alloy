// Grafana Alloy pipeline for this host: collect host, container, service,
// WAN-probe and log data and push it over the tailnet to Prometheus and Loki,
// wherever the observability profile runs. Every series and stream is tagged
// with `host` and `site` from the environment.

// ---------------------------------------------------------------- metrics

// Built-in exporters label their targets job="integrations/...", which
// overrides a scrape's job_name, so each gets a relabel to a plain job.

prometheus.exporter.unix "host" {
	procfs_path = "/host/proc"
	sysfs_path  = "/host/sys"
	rootfs_path = "/host/root"
	// Disk metadata (model, serial) from the host's udev database.
	udev_data_path = "/host/root/run/udev/data"

	// Only the collectors behind metrics that "keep" below lets through.
	// Network counters would come from Alloy's own network namespace here:
	// see "network" below.
	set_collectors = [
		"cpu", "diskstats", "filesystem", "hwmon", "loadavg", "meminfo", "pressure",
		"stat", "textfile", "thermal_zone", "uname", "vmstat",
	]

	filesystem {
		mount_points_exclude = "^/(dev|proc|run|sys|var/lib/docker/.+)($|/)"
		fs_types_exclude     = "^(autofs|binfmt_misc|cgroup2?|configfs|debugfs|devpts|devtmpfs|fusectl|hugetlbfs|mqueue|nsfs|overlay|proc|pstore|securityfs|squashfs|sysfs|tmpfs|tracefs)$"
	}

	// Written by scripts/sync.sh (deploy status) and backup sidecars.
	textfile {
		directory = "/host/root/var/lib/homelab/metrics"
	}
}

discovery.relabel "node" {
	targets = prometheus.exporter.unix.host.targets

	rule {
		target_label = "job"
		replacement  = "node"
	}
}

prometheus.scrape "host" {
	targets    = discovery.relabel.node.output
	forward_to = [prometheus.relabel.keep.receiver]
}

// The host's network interfaces. /proc/net is whichever namespace reads
// it, so through /host/proc it would show Alloy's container interfaces;
// PID 1's view (Alloy shares the host's PIDs) is the host's.
prometheus.exporter.unix "network" {
	procfs_path    = "/host/proc/1"
	sysfs_path     = "/host/sys"
	rootfs_path    = "/host/root"
	set_collectors = ["netdev"]
}

discovery.relabel "network" {
	targets = prometheus.exporter.unix.network.targets

	rule {
		target_label = "job"
		replacement  = "network"
	}
}

prometheus.scrape "network" {
	targets    = discovery.relabel.network.output
	forward_to = [prometheus.relabel.keep.receiver]
}

prometheus.exporter.cadvisor "containers" {
	docker_host = "tcp://docker-proxy:2375"
	// cAdvisor's Docker support also needs containerd, which Docker 29 runs
	// at the usual path; without it there's only a whole-host series.
	containerd_host  = "/host/root/run/containerd/containerd.sock"
	docker_only      = true
	storage_duration = "5m"

	// cAdvisor refreshes every container every few seconds (Alloy doesn't
	// expose the interval), so collect only what "keep" below lets through,
	// without a label per Docker label: about 40% less CPU.
	enabled_metrics        = ["cpu", "memory", "diskIO"]
	store_container_labels = false
}

discovery.relabel "cadvisor" {
	targets = prometheus.exporter.cadvisor.containers.targets

	rule {
		target_label = "job"
		replacement  = "cadvisor"
	}
}

prometheus.scrape "containers" {
	targets    = discovery.relabel.cadvisor.output
	forward_to = [prometheus.relabel.keep.receiver]
}

// Internet reachability from this site.
prometheus.exporter.blackbox "wan" {
	config = "{ modules: { icmp: { prober: icmp, timeout: 5s }, https: { prober: http, timeout: 10s } } }"

	target {
		name    = "cloudflare-dns"
		address = "1.1.1.1"
		module  = "icmp"
	}

	target {
		name    = "google-dns"
		address = "8.8.8.8"
		module  = "icmp"
	}

	target {
		name    = "github"
		address = "https://github.com"
		module  = "https"
	}
}

discovery.relabel "wan" {
	targets = prometheus.exporter.blackbox.wan.targets

	// The probe name only lives in the exporter's job label; keep it.
	rule {
		source_labels = ["job"]
		regex         = "integrations/blackbox/(.+)"
		target_label  = "probe"
	}

	rule {
		target_label = "job"
		replacement  = "wan"
	}
}

prometheus.scrape "wan" {
	targets    = discovery.relabel.wan.output
	forward_to = [prometheus.relabel.keep.receiver]
}

prometheus.exporter.self "alloy" { }

discovery.relabel "alloy" {
	targets = prometheus.exporter.self.alloy.targets

	rule {
		target_label = "job"
		replacement  = "alloy"
	}
}

prometheus.scrape "alloy" {
	targets    = discovery.relabel.alloy.output
	forward_to = [prometheus.relabel.keep.receiver]
}

// Any container with a `homelab.metrics.port` label.
discovery.docker "containers" {
	host = "tcp://docker-proxy:2375"
}

discovery.relabel "labelled" {
	targets = discovery.docker.containers.targets

	rule {
		source_labels = ["__meta_docker_container_label_homelab_metrics_port"]
		regex         = ".+"
		action        = "keep"
	}

	// One target per container: the address on the project network.
	rule {
		source_labels = ["__meta_docker_network_name"]
		regex         = "homelab_default"
		action        = "keep"
	}

	// A container that is restarting has no address yet.
	rule {
		source_labels = ["__meta_docker_network_ip"]
		regex         = ".+"
		action        = "keep"
	}

	rule {
		source_labels = ["__meta_docker_network_ip", "__meta_docker_container_label_homelab_metrics_port"]
		separator     = ":"
		target_label  = "__address__"
	}

	rule {
		source_labels = ["__meta_docker_container_label_homelab_metrics_path"]
		regex         = "(.+)"
		target_label  = "__metrics_path__"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		target_label  = "job"
	}
}

prometheus.scrape "labelled" {
	targets    = discovery.relabel.labelled.output
	forward_to = [prometheus.relabel.keep.receiver]
}

// Store only what an alert or dashboard uses, plus enough to see why a host
// is unwell; everything else is dropped before it reaches Prometheus. The
// services' own metrics are kept to `up`. To chart something new, add it
// here first. smartctl and UniFi are kept whole: they're why those profiles
// exist, and their hosts have NVMe disks.
prometheus.relabel "keep" {
	forward_to = [prometheus.remote_write.central.receiver]

	rule {
		source_labels = ["job", "__name__"]
		separator     = ";"
		regex         = string.join([
			".+;(up|scrape_.+)",
			"node;(homelab_.+|node_textfile_scrape_error|node_uname_info|node_boot_time_seconds|node_load(1|5|15))",
			"node;node_(cpu_seconds_total|thermal_zone_temp|pressure_.+|vmstat_pswp(in|out))",
			"node;node_memory_(MemAvailable|MemTotal|SwapTotal|SwapFree)_bytes",
			"node;node_(filesystem_(avail|size)_bytes|disk_(read|written)_bytes_total|disk_io_time_seconds_total)",
			"network;node_network_(receive|transmit)_bytes_total",
			// Fans, PoE current, undervoltage and NVMe temperature, plus the
			// chip names that tell them apart.
			"node;node_cooling_device_(cur|max)_state",
			"node;node_hwmon_(chip_names|temp_celsius|pwm|fan_rpm|curr_amps|in_lcrit_alarm_volts)",
			"cadvisor;container_(cpu_usage_seconds_total|memory_working_set_bytes|fs_writes_bytes_total)",
			"wan;probe_(success|duration_seconds)",
			"traefik;traefik_(tls_certs_not_after|service_requests_total|service_request_duration_seconds_(sum|count))",
			"(smartctl-exporter|unpoller);.+",
		], "|")
		action = "keep"
	}

	// Physical and VPN interfaces only, not Docker's bridges and veths.
	rule {
		source_labels = ["__name__", "device"]
		separator     = ";"
		regex         = "node_network_.+;(lo|docker0|br-.+|veth.+)"
		action        = "drop"
	}
}

prometheus.remote_write "central" {
	endpoint {
		url = "https://prometheus." + sys.env("HOMELAB_DOMAIN") + "/api/v1/write"

		// Only the local test stack, which has no real certificate, sets this.
		tls_config {
			insecure_skip_verify = sys.env("ALLOY_TLS_INSECURE") == "true"
		}
	}

	external_labels = {
		host = sys.env("HOST_NAME"),
		site = sys.env("SITE"),
	}
}

// ------------------------------------------------------------------- logs

discovery.relabel "logs" {
	targets = []

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(.*)"
		target_label  = "container"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		target_label  = "service"
	}
}

loki.source.docker "containers" {
	host          = "tcp://docker-proxy:2375"
	targets       = discovery.docker.containers.targets
	labels        = {"job" = "docker"}
	relabel_rules = discovery.relabel.logs.rules
	forward_to    = [loki.write.central.receiver]
}

loki.relabel "journal" {
	forward_to = []

	// With the journald log driver (SD-card hosts), container logs are in the
	// journal too; loki.source.docker already sends them.
	rule {
		source_labels = ["__journal_container_name"]
		regex         = ".+"
		action        = "drop"
	}

	rule {
		source_labels = ["__journal__systemd_unit"]
		target_label  = "unit"
	}

	rule {
		source_labels = ["__journal_priority_keyword"]
		target_label  = "level"
	}
}

loki.source.journal "system" {
	max_age       = "12h"
	labels        = {"job" = "journal"}
	relabel_rules = loki.relabel.journal.rules
	forward_to    = [loki.write.central.receiver]
}

loki.write "central" {
	endpoint {
		url = "https://loki." + sys.env("HOMELAB_DOMAIN") + "/loki/api/v1/push"

		tls_config {
			insecure_skip_verify = sys.env("ALLOY_TLS_INSECURE") == "true"
		}
	}

	external_labels = {
		host = sys.env("HOST_NAME"),
		site = sys.env("SITE"),
	}
}
