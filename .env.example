# Host configuration. Copy to .env in the repo root on each host (gitignored)
# and fill in, or pass it to bootstrap.sh with --env. This file holds
# everything that differs between hosts; the compose files contain no
# host-specific values. Editing it on a host redeploys within a minute.
#
# scripts/gen-secrets.sh prints fresh values for every generated secret.
# Values containing `$` (bcrypt hashes) must be in 'single quotes'.

# ---- what runs here ------------------------------------------------------------
# Comma-separated: dns, observability, tailscale, backup, unifi, smart.
# traefik and SSO (pocket-id, tinyauth) always run.
#   primary (pi4):    dns,tailscale,backup
#   secondary (pi5):  dns,observability,tailscale,backup,unifi,smart
COMPOSE_PROFILES=dns,tailscale,backup

# ---- identity / host (also read by bootstrap.sh) -------------------------------
HOST_NAME=primary
SITE=home
TZ=America/New_York
HOST_IP=192.168.1.10
# Resolvers for the Pi itself. Deliberately not its own Pi-hole, so the host
# can still pull images and sync git while Pi-hole is down or restarting.
HOST_DNS="1.1.1.1 1.0.0.1"
# Every service on this host is served at <service>.BASE_DOMAIN.
BASE_DOMAIN=home.example.com
# OS auto-updates (Debian, Raspberry Pi, Docker repos). Upgrades run daily at
# OS_UPGRADE_TIME; if one needs a reboot, it happens at OS_REBOOT_TIME.
# Re-run bootstrap.sh after changing these.
OS_UPGRADE_TIME=04:00
OS_REBOOT_TIME=04:30
OS_AUTO_REBOOT=true
# Subnet for the compose project network; change only if it collides.
# DOCKER_SUBNET=172.30.0.0/24

# ---- TLS (Traefik + Let's Encrypt DNS-01) -------------------------------------
ACME_EMAIL=you@example.com
ACME_DNS_PROVIDER=cloudflare
# Cloudflare API token with Zone:DNS:Edit on the zone that contains BASE_DOMAIN.
CF_DNS_API_TOKEN=changeme
# Uncomment while testing to avoid Let's Encrypt rate limits:
# ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory

# ---- SSO (always on) -----------------------------------------------------------
# Generated secret. Encrypts Pocket ID's signing keys; keep it in your password
# manager, since a restored backup is useless without it.
POCKET_ID_ENCRYPTION_KEY=changeme-at-least-16-chars
# From the OIDC clients you create in Pocket ID after first boot (README →
# "Single sign-on"). Until set, admin UIs behind SSO are unreachable.
TINYAUTH_OIDC_CLIENT_ID=
TINYAUTH_OIDC_CLIENT_SECRET=

# ---- profile: dns --------------------------------------------------------------
PIHOLE_UPSTREAMS=1.1.1.1;1.0.0.1
# Semicolon-separated dnsmasq lines. Defaults to address=/BASE_DOMAIN/HOST_IP.
# PIHOLE_DNSMASQ_LINES=

# ---- profile: observability ------------------------------------------------------
GRAFANA_OIDC_CLIENT_ID=
GRAFANA_OIDC_CLIENT_SECRET=
# PROM_RETENTION=30d
# LOKI_RETENTION=30d
# Generated: ntfy token Grafana publishes alerts with (tk_ + 29 chars), and a
# bcrypt hash of a throwaway password for the `grafana` ntfy user.
NTFY_GRAFANA_TOKEN=
NTFY_GRAFANA_PASSWORD_HASH=''
# Set empty to skip the iOS wake-up relay through ntfy.sh (Android unaffected).
# NTFY_UPSTREAM_BASE_URL=https://ntfy.sh

# ---- profile: tailscale --------------------------------------------------------
# OAuth client secret (tskey-client-...) or auth key; first login only.
TS_AUTHKEY=
TS_ROUTES=192.168.1.0/24
TS_EXTRA_ARGS=--advertise-tags=tag:homelab

# ---- profile: backup -----------------------------------------------------------
# Any restic repository. Keep RESTIC_PASSWORD in your password manager:
# without it the backups can't be decrypted.
RESTIC_REPOSITORY=s3:https://s3.us-west-004.backblazeb2.com/my-bucket/home
RESTIC_PASSWORD=
RESTIC_S3_ACCESS_KEY_ID=
RESTIC_S3_SECRET_ACCESS_KEY=
# 6-field cron (with seconds), in TZ.
# BACKUP_CRON=0 30 3 * * *

# ---- profile: unifi ------------------------------------------------------------
UNIFI_URL=https://192.168.1.1
UNIFI_API_KEY=
