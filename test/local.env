# Host config for the local smoke test (test/smoke.sh) on Docker Desktop.
# Throwaway values only; nothing here is used on a real host.

COMPOSE_PROFILES=dns,observability,backup,unifi,smart

HOST_NAME=local
SITE=local
TZ=UTC
HOST_IP=127.0.0.1
BASE_DOMAIN=home.lab.test

ACME_EMAIL=smoke@example.com
CF_DNS_API_TOKEN=unused
# Unreachable on purpose: no certificate requests leave the machine, and
# Traefik serves its self-signed default certificate instead.
ACME_CA_SERVER=https://127.0.0.1:1/directory

POCKET_ID_ENCRYPTION_KEY=local-smoke-test-encryption-key
POCKET_ID_STATIC_API_KEY=local-smoke-test-static-api-key

NTFY_GRAFANA_TOKEN=tk_localsmoketesttoken0000000000
NTFY_GRAFANA_PASSWORD_HASH='$2y$10$1WB79XPbpH7mOPD/fDCmQ.yBFrdgPKAR0NORSuB7gKwFJbQhAHAbq'
NTFY_UPSTREAM_BASE_URL=

RESTIC_REPOSITORY=/restic
RESTIC_PASSWORD=local-smoke-test

UNIFI_URL=https://127.0.0.1:1
UNIFI_API_KEY=unused
