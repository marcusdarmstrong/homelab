# Settings for hosts whose .env declares HOST_STORAGE=sdcard. Layered under
# the host's .env, so a key set there still wins. Each trades a little
# durability for far fewer writes to the card (README → SD-card hosts).

# Docker keeps its copy of container logs in the journal, which Raspberry Pi
# OS holds in RAM. Logs still reach Loki; `docker logs` history is lost on
# reboot. Applied by bootstrap.sh.
DOCKER_LOG_DRIVER=journald

# Loki writes each log line once instead of twice; a crash can lose the last
# few minutes of logs.
LOKI_WAL_ENABLED=false

# Pi-hole flushes query stats to its database every 10 minutes, not every
# minute.
PIHOLE_DB_INTERVAL=600

# Grafana saves alert state every 5 minutes instead of after each
# evaluation; a restart forgets what changed since the last save.
GRAFANA_ALERT_STATE_SAVE_INTERVAL=5m
